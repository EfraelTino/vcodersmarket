---
import "@/styles/global.css";

const { title } = Astro.props;
const { user: authUser } = Astro.locals;
const user = {
  name:
    authUser?.user_metadata?.full_name ||
    authUser?.user_metadata?.name ||
    "Usuario",
  email: authUser?.email || "",
  avatar:
    authUser?.user_metadata?.avatar_url ||
    authUser?.user_metadata?.picture ||
    `https://api.dicebear.com/7.x/initials/svg?seed=${authUser?.email || "user"}`,
};

const navItems = [
  { name: "Dashboard", href: "/app/dashboard", icon: "home" },
  { name: "Explorar", href: "/app/dashboard/explore", icon: "search" },
  { name: "Proyectos", href: "/app/dashboard/projects", icon: "folder" },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es" class="h-full bg-gray-50">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | VibeMarket Console</title>
  </head>
  <body
    class="h-full overflow-hidden flex text-sm text-gray-700 font-sans antialiased"
  >
    <aside
      class="hidden w-64 flex-col border-r border-gray-200 bg-white md:flex"
    >
      <div class="flex flex-col items-start mt-4 border-b border-gray-100 px-6">
        <a href="/" class="flex items-center gap-2 font-bold text-gray-900">
          <div
            class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-tr from-orange-500 to-purple-600 text-white"
          >
            V
          </div>
          <span>VibeMarket</span>
        </a>
        <a
          href="/app/dashboard/new-project"
          class="flex items-center justify-center bg-gray-900 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-800 transition-colors shadow-sm w-full my-3"
        >
          + New Project
        </a>
      </div>

      <nav class="flex-1 overflow-y-auto px-4 py-4">
        <ul class="space-y-1">
          <li></li>
          {
            navItems.map((item) => {
              const isActive = currentPath === item.href;
              return (
                <li>
                  <a
                    href={item.href}
                    class:list={[
                      "group flex items-center gap-3 rounded-md px-3 py-2 font-medium transition-colors",
                      isActive
                        ? "bg-gray-100 text-gray-900"
                        : "text-gray-500 hover:bg-gray-50 hover:text-gray-900",
                    ]}
                  >
                    {item.icon === "home" && (
                      <svg
                        class="h-4 w-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
                        />
                      </svg>
                    )}
                    {item.icon === "search" && (
                      <svg
                        class="h-4 w-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                        />
                      </svg>
                    )}
                    {item.icon === "folder" && (
                      <svg
                        class="h-4 w-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"
                        />
                      </svg>
                    )}
                    {item.icon === "chart" && (
                      <svg
                        class="h-4 w-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"
                        />
                      </svg>
                    )}
                    {item.icon === "wallet" && (
                      <svg
                        class="h-4 w-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"
                        />
                      </svg>
                    )}

                    {item.name}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <div class="border-t border-gray-200 px-4 py-2 relative">
        <div
          id="user-dropdown"
          class="hidden absolute bottom-full left-4 right-4 mb-2 min-w-[12rem] overflow-hidden rounded-md border border-gray-200 bg-white p-1 shadow-lg z-50 animate-in fade-in zoom-in-95 duration-200"
        >
          <div
            class="px-2 py-1.5 text-xs font-semibold text-gray-500 uppercase tracking-wider border-b border-gray-50 mb-1"
          >
            My Account
          </div>

          <a
            href="/app/dashboard/settings"
            class="flex cursor-pointer select-none items-center rounded-sm px-2 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-gray-900 transition-colors"
          >
            <svg
              class="mr-2 h-4 w-4 text-gray-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
              ></path><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg
            >
            Settings
          </a>

          <div class="h-px my-1 bg-gray-100"></div>

          <form action="/api/auth/signout" method="POST" class="w-full">
            <button
              type="submit"
              class="w-full flex cursor-pointer select-none items-center rounded-sm px-2 py-2 text-sm text-secondary hover:bg-red-50 hover:text-secondary/80 transition-colors"
            >
              <svg
                class="mr-2 h-4 w-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
                ></path></svg
              >
              Log Out
            </button>
          </form>
        </div>

        <button
          id="user-menu-btn"
          class="flex w-full items-center gap-3 rounded-lg p-2 hover:bg-gray-100 transition-colors text-left outline-none"
        >
          <img
            src={user.avatar}
            alt="Avatar"
            class="h-9 w-9 rounded-full bg-gray-200 border border-gray-200"
          />
          <div class="flex-1 overflow-hidden">
            <p class="truncate font-medium text-gray-900">{user.name}</p>
            <p class="truncate text-xs text-gray-500">{user.email}</p>
          </div>
          <svg
            class="h-4 w-4 text-gray-400"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8 9l4-4 4 4m0 6l-4 4-4-4"></path>
          </svg>
        </button>
      </div>
    </aside>

    <div class="flex flex-1 flex-col overflow-hidden">
      <header
        class="flex h-16 items-center justify-between border-b border-gray-200 bg-white px-6 md:hidden"
      >
        <div class="flex items-center gap-4">
          <button
            id="mobile-menu-btn"
            class="text-gray-500 hover:text-gray-900"
          >
            <svg
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16"></path></svg
            >
          </button>
          <span class="font-semibold text-gray-900">VibeMarket</span>
        </div>
      </header>

      <main class="flex-1 overflow-y-auto bg-gray-50 p-3 md:p-8">
        <div class="mx-auto max-w-5xl">
          <slot />
        </div>
      </main>
    </div>

    <script>
      // 1. Lógica del Menú Móvil (Simple)
      const btn = document.getElementById("mobile-menu-btn");
      btn?.addEventListener("click", () => console.log("Toggle mobile menu"));

      // 2. Lógica del Dropdown de Usuario
      const userBtn = document.getElementById("user-menu-btn");
      const userDropdown = document.getElementById("user-dropdown");

      if (userBtn && userDropdown) {
        // Toggle click
        userBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          userDropdown.classList.toggle("hidden");
        });

        // Cerrar click fuera
        document.addEventListener("click", (e) => {
          // Si el click NO fue en el botón NI en el dropdown, cierra el dropdown
          if (!userBtn.contains(e.target) && !userDropdown.contains(e.target)) {
            userDropdown.classList.add("hidden");
          }
        });
      }
      
    </script>
  </body>
</html>
