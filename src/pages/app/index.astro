---
import Background from "@/components/ui/Background.astro";
import Layout from "@/layouts/Layout.astro";
export const prerender = false;
// src/pages/login.astro
---

<Layout title="Acceso - VibeMarket">
  <div class="min-h-screen relative overflow-hidden flex flex-col items-center justify-center ">
    <Background />
      <main
        id="main"
        class="relative z-10 h-full flex-1 flex flex-col items-center pt-8 md:pt-13 text-center w-full max-w-7xl mx-auto px-4 justify-center"
      >
        <div
          class="relative bg-white/80 backdrop-blur-md border border-gray-200 p-8 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] flex flex-col items-center text-center max-w-80 w-full"
        >
          <div class="mb-6">
            <div
              class="w-12 h-12 bg-gradient-to-tr from-orange-500 to-purple-600 rounded-lg flex items-center justify-center text-white font-bold text-xl shadow-lg shadow-orange-500/20"
            >
              V
            </div>
          </div>

          <h1 class="text-3xl font-medium text-gray-900 mb-2 tracking-tight">
                Welcome
          </h1>
          <p class="text-gray-500 text-sm mb-8">
            Log in to start buying or selling.
          </p>

          <button
            id="google-login-btn"
            class="w-full flex items-center justify-center gap-3 bg-white text-gray-700 font-medium px-6 py-2 cursor-pointer rounded-xl border border-gray-200 hover:bg-gray-50 hover:border-gray-300 hover:shadow-sm transition-all duration-200 group relative"
          >
            <svg
              id="google-icon"
              class="w-5 h-5 transition-opacity duration-200"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                fill="#4285F4"></path>
              <path
                d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                fill="#34A853"></path>
              <path
                d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.2 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
                fill="#FBBC05"></path>
              <path
                d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
                fill="#EA4335"></path>
            </svg>

            <svg 
              id="loading-spinner" 
              class="animate-spin h-5 w-5 text-gray-600 absolute hidden" 
              xmlns="http://www.w3.org/2000/svg" 
              fill="none" 
              viewBox="0 0 24 24"
            >
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>

            <span id="btn-text" class="transition-opacity duration-200">Continue with Google</span>
          </button>

          <div class="mt-8 text-xs text-gray-400">
          By continuing, you agree to our
            <a
              href="/terms"
              class="text-gray-600 hover:text-secondary underline transition-colors"
              >Terms</a
            >.
          </div>
        </div>

        <div class="mt-6 text-center">
          <a
            href="/"
            class="text-sm text-gray-400 hover:text-gray-600 transition-colors"
          >
            ← Volver al inicio
          </a>
        </div>
      </main>
  </div>
</Layout>
<script>
  const btn = document.getElementById('google-login-btn');
  const btnText = document.getElementById('btn-text');
  const googleIcon = document.getElementById('google-icon');
  const spinner = document.getElementById('loading-spinner');

  btn?.addEventListener('click', async () => {
    // 1. UI Loading
    btn.setAttribute('disabled', 'true');
    btn.classList.add('opacity-75', 'cursor-not-allowed');
    if(btnText) btnText.classList.add('opacity-0');
    if(googleIcon) googleIcon.classList.add('opacity-0');
    if(spinner) spinner.classList.remove('hidden');

    try {
      // 2. Pedimos la URL al servidor
      const response = await fetch("/api/auth/signin", {
        method: "POST",
      });

      if (!response.ok) throw new Error("Error en el servidor");

      // 3. Leemos la URL del JSON
      const data = await response.json();

      // 4. Navegamos manualmente (Esto evita el error de CORS)
      if (data.url) {
        window.location.href = data.url;
      } else {
        throw new Error("No URL returned");
      }

    } catch (error) {
      console.error("Login error:", error);
      alert("Error al iniciar sesión.");
      
      // Reset UI
      btn.removeAttribute('disabled');
      btn.classList.remove('opacity-75', 'cursor-not-allowed');
      if(btnText) btnText.classList.remove('opacity-0');
      if(googleIcon) googleIcon.classList.remove('opacity-0');
      if(spinner) spinner.classList.add('hidden');
    }
  });
</script>