---
// src/pages/app/index.astro
import DashboardLayout from "@/layouts/DashboardLayout.astro";

// --- MOCK DATA (Datos Simulados) ---
const user = { name: "Alex" };

const stats = [
  { label: "Ingresos Totales", value: "$1,240.50", change: "+12%", trend: "up", icon: "dollar" },
  { label: "Ventas Activas", value: "24", change: "+4", trend: "up", icon: "cart" },
  { label: "Visitas al Perfil", value: "892", change: "-2%", trend: "down", icon: "eye" },
];

const recentSales = [
  { project: "SaaS Starter Kit AI", buyer: "startup_mike", date: "Hace 2h", amount: "$49.00" },
  { project: "GPT-4 Wrapper", buyer: "dev_jane", date: "Hace 5h", amount: "$29.00" },
  { project: "Image Gen API", buyer: "visual_studio", date: "Ayer", amount: "$120.00" },
  { project: "Voice Cloner V2", buyer: "podcaster_x", date: "Ayer", amount: "$15.00" },
];
---

<DashboardLayout title="Resumen">
  
  <div class="mb-8 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Hola, {user.name} 👋</h1>
      <p class="text-gray-500 text-sm">Aquí tienes el resumen de tu actividad hoy.</p>
    </div>
    <button class="bg-gray-900 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-800 transition-colors shadow-sm">
      + Nuevo Proyecto
    </button>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    {stats.map((stat) => (
      <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-[0_2px_10px_rgb(0,0,0,0.02)] hover:shadow-md transition-shadow">
        <div class="flex items-center justify-between mb-4">
          <span class="text-gray-500 text-sm font-medium">{stat.label}</span>
          <div class={`p-2 rounded-lg ${stat.trend === 'up' ? 'bg-green-50 text-green-600' : 'bg-red-50 text-red-600'}`}>
             {/* Icono condicional simple */}
             {stat.icon === 'dollar' && <span>$</span>}
             {stat.icon === 'cart' && <span>🛒</span>}
             {stat.icon === 'eye' && <span>👁️</span>}
          </div>
        </div>
        <div class="flex items-end gap-2">
          <span class="text-3xl font-bold text-gray-900">{stat.value}</span>
          <span class={`text-xs font-medium mb-1 ${stat.trend === 'up' ? 'text-green-600' : 'text-red-600'}`}>
            {stat.change}
          </span>
        </div>
      </div>
    ))}
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <div class="lg:col-span-2 bg-white p-6 rounded-xl border border-gray-200 shadow-[0_2px_10px_rgb(0,0,0,0.02)]">
      <h3 class="font-semibold text-gray-900 mb-6">Rendimiento de Ventas</h3>
      <div class="h-64 flex items-end justify-between gap-2 px-2">
        {[40, 65, 30, 80, 55, 90, 45, 70, 100, 60, 75, 50].map((h) => (
          <div class="w-full bg-gray-100 rounded-t-sm relative group hover:bg-indigo-50 transition-colors">
            <div 
                class="absolute bottom-0 left-0 right-0 bg-gray-900 rounded-t-sm transition-all duration-500 group-hover:bg-indigo-600" 
                style={`height: ${h}%`}
            ></div>
          </div>
        ))}
      </div>
      <div class="mt-4 flex justify-between text-xs text-gray-400 uppercase font-medium">
        <span>Ene</span><span>Feb</span><span>Mar</span><span>Abr</span><span>May</span><span>Jun</span>
      </div>
    </div>

    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-[0_2px_10px_rgb(0,0,0,0.02)]">
      <h3 class="font-semibold text-gray-900 mb-4">Ventas Recientes</h3>
      <div class="space-y-4">
        {recentSales.map((sale) => (
          <div class="flex items-center justify-between pb-4 border-b border-gray-50 last:border-0 last:pb-0">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-gradient-to-br from-orange-100 to-purple-100 flex items-center justify-center text-xs font-bold text-purple-600">
                {sale.buyer.charAt(0).toUpperCase()}
              </div>
              <div>
                <p class="text-sm font-medium text-gray-900">{sale.project}</p>
                <p class="text-xs text-gray-500">@{sale.buyer}</p>
              </div>
            </div>
            <div class="text-right">
              <p class="text-sm font-bold text-gray-900">{sale.amount}</p>
              <p class="text-xs text-gray-400">{sale.date}</p>
            </div>
          </div>
        ))}
      </div>
      <button class="w-full mt-6 py-2 text-sm text-gray-500 hover:text-gray-900 font-medium border border-dashed border-gray-300 rounded-lg hover:border-gray-400 transition-colors">
        Ver todas las transacciones
      </button>
    </div>

  </div>

</DashboardLayout>