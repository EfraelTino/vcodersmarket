---
import { SubmitProjectForm } from "@/components/sections/SubmitProjectForm";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
---

<DashboardLayout title="Submit Project">
  <div class="max-w-4xl mx-auto pb-20">
    <div class="mb-8">
      <a
        href="/app/dashboard/projects"
        class="text-sm text-gray-500 hover:text-gray-900 mb-2 inline-flex items-center gap-1"
      >
        ← Back to projects
      </a>
      <h1 class="text-3xl font-bold text-gray-900">Submit a Project</h1>
      <p class="text-gray-500 mt-1">
        Share your creation with the community. Get traffic. Get vibes.
      </p>
    </div>
    <SubmitProjectForm client:load />
  </div>
</DashboardLayout>
